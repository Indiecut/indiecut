# Skip onnxruntime-node CUDA EP download.
# @huggingface/transformers pulls in onnxruntime-node; IndieCut only uses
# onnxruntime-web (WASM) in the browser/Electron worker. Without this, Linux
# npm ci (e.g. release deploy-web) tries to fetch GPU binaries from GitHub
# Releases and can fail with 404/502.
onnxruntime-node-install-cuda=skip
