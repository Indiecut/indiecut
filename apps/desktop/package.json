{
  "name": "@indiecut/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "IndieCut desktop (Electron)",
  "author": {
    "name": "Sumit Kumar",
    "url": "https://github.com/sumit1826"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/copy-ort-assets.mjs",
    "prebuild": "node ../../scripts/copy-ort-assets.mjs",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs",
    "build": "vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder --mac --win",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.indiecut.app",
    "productName": "IndieCut",
    "copyright": "Copyright © IndieCut contributors",
    "electronVersion": "33.2.1",
    "directories": {
      "buildResources": "../../build",
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "../../build/icon.icns",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ]
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "icon": "../../build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IndieCut",
      "installerIcon": "../../build/icon.ico",
      "uninstallerIcon": "../../build/icon.ico",
      "artifactName": "${productName}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "icon": "../../build/icon.png",
      "category": "Video",
      "target": ["AppImage"]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Indiecut",
        "repo": "indiecut",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@indiecut/editor": "*",
    "@indiecut/platform": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "33.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
