{
  "name": "indiecut",
  "version": "1.0.0",
  "private": true,
  "description": "IndieCut — open-source desktop video editor",
  "author": {
    "name": "Sumit Kumar",
    "url": "https://github.com/sumit1826"
  },
  "license": "MIT",
  "homepage": "https://indiecut.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Indiecut/indiecut.git"
  },
  "bugs": {
    "url": "https://github.com/Indiecut/indiecut/issues"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-ort-assets.mjs",
    "predev": "node scripts/copy-ort-assets.mjs",
    "prebuild": "node scripts/copy-ort-assets.mjs",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs",
    "build": "vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx src/compositor/blend.test.ts && tsx src/compositor/transform.test.ts && tsx src/compositor/mask.test.ts && tsx src/compositor/removeBgColor.test.ts && tsx src/engine/animatable.test.ts && tsx src/ai/captions/segmentSpeechIntoLines.test.ts && tsx src/ai/captions/parseTimedTextFile.test.ts && tsx src/ai/captions/downmixToMono16k.test.ts",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.indiecut.app",
    "productName": "IndieCut",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Video"
    },
    "win": {
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "localforage": "^1.10.0",
    "mediabunny": "^1.65.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
