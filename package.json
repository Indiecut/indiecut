{
  "name": "indiecut",
  "version": "1.0.0",
  "private": true,
  "description": "IndieCut — open-source video editor (desktop + web)",
  "author": {
    "name": "Sumit Kumar",
    "url": "https://github.com/sumit1826"
  },
  "license": "MIT",
  "homepage": "https://indiecut.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Indiecut/indiecut.git"
  },
  "bugs": {
    "url": "https://github.com/Indiecut/indiecut/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-ort-assets.mjs",
    "dev": "npm run dev -w @indiecut/desktop",
    "dev:web": "npm run dev -w @indiecut/web",
    "build": "npm run build -w @indiecut/desktop",
    "build:web": "npm run build -w @indiecut/web",
    "pack": "npm run pack -w @indiecut/desktop",
    "dist:mac": "npm run dist:mac -w @indiecut/desktop",
    "dist:win": "npm run dist:win -w @indiecut/desktop",
    "dist": "npm run dist -w @indiecut/desktop",
    "typecheck": "npm run typecheck -w @indiecut/platform && npm run typecheck -w @indiecut/editor && npm run typecheck -w @indiecut/desktop && npm run typecheck -w @indiecut/web",
    "test:unit": "npm run test:unit -w @indiecut/editor",
    "preview:web": "npm run preview -w @indiecut/web"
  },
  "engines": {
    "node": ">=20"
  }
}
